{"url":"https://api.github.com/repos/RustPython/RustPython/issues/4786","repository_url":"https://api.github.com/repos/RustPython/RustPython","labels_url":"https://api.github.com/repos/RustPython/RustPython/issues/4786/labels{/name}","comments_url":"https://api.github.com/repos/RustPython/RustPython/issues/4786/comments","events_url":"https://api.github.com/repos/RustPython/RustPython/issues/4786/events","html_url":"https://github.com/RustPython/RustPython/issues/4786","id":1642702255,"node_id":"I_kwDOCA8Bec5h6aWv","number":4786,"title":"Type name cannot contain surrogates","user":{"login":"DimitrisJim","id":8123587,"node_id":"MDQ6VXNlcjgxMjM1ODc=","avatar_url":"https://avatars.githubusercontent.com/u/8123587?v=4","gravatar_id":"","url":"https://api.github.com/users/DimitrisJim","html_url":"https://github.com/DimitrisJim","followers_url":"https://api.github.com/users/DimitrisJim/followers","following_url":"https://api.github.com/users/DimitrisJim/following{/other_user}","gists_url":"https://api.github.com/users/DimitrisJim/gists{/gist_id}","starred_url":"https://api.github.com/users/DimitrisJim/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/DimitrisJim/subscriptions","organizations_url":"https://api.github.com/users/DimitrisJim/orgs","repos_url":"https://api.github.com/users/DimitrisJim/repos","events_url":"https://api.github.com/users/DimitrisJim/events{/privacy}","received_events_url":"https://api.github.com/users/DimitrisJim/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":947386063,"node_id":"MDU6TGFiZWw5NDczODYwNjM=","url":"https://api.github.com/repos/RustPython/RustPython/labels/C-bug","name":"C-bug","color":"f5f1fd","default":false,"description":"Something isn't working","archived_at":null,"archived_by":null},{"id":1397253490,"node_id":"MDU6TGFiZWwxMzk3MjUzNDkw","url":"https://api.github.com/repos/RustPython/RustPython/labels/C-compat","name":"C-compat","color":"f5f1fd","default":false,"description":"A discrepancy between RustPython and CPython","archived_at":null,"archived_by":null}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2023-03-27T19:40:05Z","updated_at":"2023-05-01T19:05:54Z","closed_at":null,"assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Issue caught after an update to `test_builtins` in #4765. Creating a new type and supplying as a name a value that contains a surrogate (in this case `\\udcdc` is used) should result in an error.\r\n\r\nRustPython:\r\n\r\n```python\r\n>>> type(\"A\\udcdcB\", (), {})\r\n>>> <class '__main__.A�B'>\r\n```\r\n\r\nWhile in CPython:\r\n\r\n```python\r\n>>> type(\"A\\udcdcB\", (), {})\r\nTraceback (most recent call last):\r\n  File \"<stdin>\", line 1, in <module>\r\nUnicodeEncodeError: 'utf-8' codec can't encode character '\\udcdc' in position 1: surrogates not allowed\r\n```\r\n","closed_by":null,"reactions":{"url":"https://api.github.com/repos/RustPython/RustPython/issues/4786/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/RustPython/RustPython/issues/4786/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}