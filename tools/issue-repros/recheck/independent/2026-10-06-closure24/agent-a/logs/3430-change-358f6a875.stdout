+            };
+        }
+
+        #[pymethod]
+        fn get(&self, args: GetArgs, vm: &VirtualMachine) -> PyResult {
+            let default = args.default.unwrap_or_none(vm);
+            let Some(attrib) = self.attrib_opt() else {
+                return Ok(default);
