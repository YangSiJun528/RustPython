         vm: &VirtualMachine,
         code: frozen::FrozenCodeObject<B>,
     ) -> PyRef<Self> {
-        Self::new_ref_with_bag(vm, code.decode(PyVmBag(vm)))
+        let py_code = Self::new_ref_with_bag(vm, code.decode(PyVmBag(vm)));
+        apply_frozen_co_filename(&py_code, vm);
