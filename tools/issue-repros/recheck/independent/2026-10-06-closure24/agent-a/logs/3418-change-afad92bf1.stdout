+
+    #[pyclass(with(Callable), flags(IMMUTABLETYPE, DISALLOW_INSTANTIATION))]
+    impl PyKeyWrapper {
+        #[pygetset]
+        fn obj(&self, vm: &VirtualMachine) -> PyObjectRef {
+            self.object.read().clone().unwrap_or_else(|| vm.ctx.none())
+        }
+
+        #[pygetset(setter)]
+        fn set_obj(&self, value: PySetterValue) {
