+    /// Serialize set elements in `sorted(v, key=marshal.dumps)` order.
+    fn write_set_elements(
+        buf: &mut Vec<u8>,
+        elems: &[PyObjectRef],
+        refs: &mut Option<WriterRefTable>,
+        version: i32,
+        allow_code: bool,
