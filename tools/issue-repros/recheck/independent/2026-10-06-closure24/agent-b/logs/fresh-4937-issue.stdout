0,"total_blocking":0},"body":"email.message_from_string.get() fails parses the special text \"Subject:=?us-ascii?X?value?=\", See the following example.\r\n\r\ntest.py\r\n```\r\nimport email\r\nimport email.policy\r\n\r\nmytext = \"Subject:=?us-ascii?X?value?=\"\r\nem = email.message_from_string(mytext, policy=email.policy.default)\r\nem.get('Subject')\r\n\r\n```\r\n\r\nBehaviors on CPython 3.8.0,3.9.0,3.11.3: work normally\r\n\r\nBehaviors on RustPython 0.2.0:\r\n\r\n```\r\nTraceback (most recent call last):\r\n  File \"/home/xxm/Desktop/RustPython/test.py\", line 569, in <module>\r\n    em.get('Subject')\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/message.py\", line 471, in get\r\n    return self.policy.header_fetch_parse(k, v)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/policy.py\", line 162, in header_fetch_parse\r\n    return self.header_factory(name, value)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/headerregistry.py\", line 586, in __call__\r\n    return self[name](name, value)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/headerregistry.py\", line 197, in __new__\r\n    cls.parse(value, kwds)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/headerregistry.py\", line 269, in parse\r\n    kwds['parse_tree'] = cls.value_parser(value)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/_header_value_parser.py\", line 1498, in get_unstructured\r\n    pass\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/_header_value_parser.py\", line 1494, in get_unstructured\r\n    token, value = get_encoded_word(value)\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/_header_value_parser.py\", line 1447, in get_encoded_word\r\n    \"encoded word format invalid: '{}'\".format(ew.cte))\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/_header_value_parser.py\", line 1444, in get_encoded_word\r\n    text, charset, lang, defects = _ew.decode('=?' + tok + '?=')\r\n  File \"/home/xxm/.cargo/git/checkouts/rustpython-f8ef4d934ac33cd8/0284059/pylib/Lib/email/_encoded_words.py\", line 166, in decode\r\n    bstring, defects = _cte_decoders[cte](bstring)\r\nKeyError: x\r\n```\r\n\r\n\r\nEnvironment:\r\nUbuntu 18.04\r\nRustPython 0.2.0 [0284059](https://github.com/RustPython/RustPython/commit/02840593bc56ae416ba2646166628f1712d6cf43)\r\nCPython 3.8.0, 3.9.0, 3.11.3","closed_by":null,"reactions":{"url":"https://api.github.com/repos/RustPython/RustPython/issues/4937/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/RustPython/RustPython/issues/4937/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}