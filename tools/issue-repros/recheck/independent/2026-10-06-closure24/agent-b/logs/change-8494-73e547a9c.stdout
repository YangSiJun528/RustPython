+    Tls1_2 = 0x0303,
+    Tls1_3 = 0x0304,
+    MaxSupported = -1,
+}
+
+pub const PROTO_TLSV1_2: i32 = ProtoVersion::Tls1_2 as i32;
+pub const PROTO_TLSV1_3: i32 = ProtoVersion::Tls1_3 as i32;
+
