+    None = 0,
+    Optional = 1,
+    Required = 2,
+}
+
+pub const CERT_NONE: i32 = CertRequirements::None as i32;
+pub const CERT_OPTIONAL: i32 = CertRequirements::Optional as i32;
+pub const CERT_REQUIRED: i32 = CertRequirements::Required as i32;
