+        verify_flags: PyRwLock<i32>,
+        options: PyRwLock<i32>,
+        minimum_version: PyRwLock<i32>,
+        maximum_version: PyRwLock<i32>,
+        alpn_protocols: PyRwLock<Vec<Vec<u8>>>,
