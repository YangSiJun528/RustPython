         op: None,
-        doc: "Implement self*=value.",
+        doc: "__imul__($self, value, /)\n--\n\nImplement self*=value.",
     },
 ];
 
diff --git a/crates/vm/src/vm/context.rs b/crates/vm/src/vm/context.rs
index d886dbaf2..53c743931 100644
--- a/crates/vm/src/vm/context.rs
+++ b/crates/vm/src/vm/context.rs
@@ -628,13 +628,14 @@ impl Context {
         getter: fn(&VirtualMachine, PyObjectRef) -> PyResult,
         setter: MemberSetterFunc,
         class: &'static Py<PyType>,
+        doc: Option<&str>,
