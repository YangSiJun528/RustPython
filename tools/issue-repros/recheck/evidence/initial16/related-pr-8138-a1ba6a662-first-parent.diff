+fn take_docstring(body: &mut ast::Suite) -> Option<TextRange> {
+    let ast::Stmt::Expr(expr_stmt) = body.first()? else {
+        return None;
+    };
+    if let Some((_, range)) = string_literal_expr_value(&expr_stmt.value) {
+        body.remove(0);
+        return Some(range);
+    }
