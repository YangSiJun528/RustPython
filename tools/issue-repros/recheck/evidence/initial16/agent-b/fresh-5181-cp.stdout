locale C '' [] '.'
123456789 n '123456789'
-123456789 n '-123456789'
123456789 15n '      123456789'
123456789 015n '000000123456789'
1234.5 n '1234.5'
locale en_US.UTF-8 ',' [3, 0] '.'
123456789 n '123,456,789'
-123456789 n '-123,456,789'
123456789 15n '    123,456,789'
123456789 015n '000,123,456,789'
1234.5 n '1,234.5'
locale de_DE.UTF-8 '.' [3, 0] ','
123456789 n '123.456.789'
-123456789 n '-123.456.789'
123456789 15n '    123.456.789'
123456789 015n '000.123.456.789'
1234.5 n '1.234,5'
locale hi_IN.UTF-8 ',' [3, 2, 0] '.'
